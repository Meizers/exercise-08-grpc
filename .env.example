POSTGRES_USER=noderegistry
POSTGRES_PASSWORD=noderegistry
POSTGRES_DB=noderegistry
DATABASE_URL=postgresql://noderegistry:noderegistry@db:5432/noderegistry

# Port the gRPC registry listens on, inside the compose network only.
GRPC_PORT=50051
# Address the REST gateway dials. "grpc_server" is the compose service name,
# resolved by Docker's internal DNS.
GRPC_SERVER_ADDRESS=grpc_server:50051
